    },
    {
      "id": "IcymRvSBYY-n3yYORSvyj",
      "type": "text",
      "x": 1537.134642706527,
      "y": 1434.6631365083394,
      "width": 275.615478515625,
      "height": 169.7148820396601,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMN",
      "roundness": null,
      "seed": 799946518,
      "version": 3446,
      "versionNonce": 1974332346,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785942852283,
      "link": null,
      "locked": false,
      "text": "#1 primero encontrar el cero (el desplazamiento)\n\nwhile l <= r {\n    m = l + (r - l) / 2\n    if n[m] == n[r]\n        return l\n\n    if n[m] < n[r] {\n        r = m - 1     \n    } else {\n        l = m + 1\n    }\n}",
      "fontSize": 10.443992740902159,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#1 primero encontrar el cero (el desplazamiento)\n\nwhile l <= r {\n    m = l + (r - l) / 2\n    if n[m] == n[r]\n        return l\n\n    if n[m] < n[r] {\n        r = m - 1     \n    } else {\n        l = m + 1\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
